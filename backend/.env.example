# Project Configuration
PROJECT_NAME="FastAPI Full-Stack AI & ML Service"
DEBUG=false
SECRET_KEY="change_this_to_a_super_secret_key_in_production"
DEVICE="cpu"

# Primary LLM: Ollama via Public Ngrok Tunnel Bridge (Default)
USE_OLLAMA=true
OLLAMA_URL=https://keith-unstarting-microtonally.ngrok-free.dev
OLLAMA_LOCAL_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_API_SECRET=your_ollama_secret_here
NGROK_AUTH=your_ngrok_auth_token_here

# Backup Cloud LLM: Groq Cloud
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Vector Database (Pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=hr-policies
PINECONE_NAMESPACE=hr-policies
